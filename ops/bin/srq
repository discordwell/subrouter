          and summarize(old_claude)["resets_from_claim"] is False)

    def resets_output(usage, peers, argv=()):
        def fake_get(path):
            if path == PEERS_USAGE_PATH:
                if peers is None:
                    raise SrqError(f"HTTP 404 from {BASE}{path}")
                return peers
            return usage
        saved = globals()["_get"]
        globals()["_get"] = fake_get
        out = io.StringIO()
        try:
            with contextlib.redirect_stdout(out):
                cmd_resets(list(argv))
        finally:
            globals()["_get"] = saved
        return out.getvalue()

    shared = listing(dict(holder_row(5, True, "eligible"), label="shared@example.com"), [held("week", 1, week_ends)])
    local = [listing(dict(holder_row(0, True, "eligible"), label="alpha@example.com"),
                     [held("week", 1, week_ends), held("fable", 2, fable_ends)]), shared]
