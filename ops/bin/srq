    check("srq resets: when it expires, the kind, the count, where it lives, its week and Fable meters and its roll",
          week_line.startswith(f"  {md[week_ends]} {_instant(week_ends).astimezone():%H:%M} ")
          and " week reset " in week_line and "  local  " in week_line
