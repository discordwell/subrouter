                    held("codex_rate_limits", 1, expiry="not_read")]),
           listing(dict(codex_row(1, 20, 300000), label="spark@example.com"),
                   [held("unknown", 1, credit_b, raw_type="codex_spark_limits", gives_back=["weekly"], manual_only=True)])]
    old = [dict(old_claude, id="old0", label="old@example.com")]
    peers = {"peers": [
        {"name": "box", "url": "https://box:31416", "reachable": True, "as_of": "2026-11-23T08:00:00Z", "error": "", "accounts": box},
        {"name": "old", "url": "https://old:31416", "reachable": False, "as_of": "2026-11-23T07:00:00Z",
         "error": "peer returned 502 Bad Gateway", "accounts": old},
        {"name": "dead", "url": "https://dead:31416", "reachable": False, "as_of": "", "error": "dial tcp: i/o timeout", "accounts": None}]}
    text = resets_output(local, peers)
    lines = text.splitlines()
    rows = [ln for ln in lines if ln.startswith("  ") and not ln.startswith("  expires")]
    accounts_in_order = [next((a for a in ("alpha", "shared", "dev", "spark", "old") if a + "@" in ln), "?") for ln in rows]
