          and any(ln.startswith("  no date given") and "old@" in ln for ln in rows))
    check("srq resets: a peer read from its last good body says so, and an unreadable one is LOUD",
          "(peer old: the last good reading, from 2026-11-23T07:00:00Z; its latest read failed: peer returned 502 Bad Gateway)" in lines
          and f"{REMOTE_UNREADABLE}  peer dead: dial tcp: i/o timeout; its resets are MISSING" in lines)
    check("srq resets: the last line totals each kind and expiry date",
          lines[-1] == f"totals: 3 week resets expire {md[week_ends]}; 1 Codex credit expires {md[credit_a]};"
                       f" 1 reset of an unknown kind expires {md[credit_b]}; 1 Codex credit expires {md[credit_c]};"
                       f" 2 Fable resets expire {md[fable_ends]}; 1 Codex credit, expiry not read; 2 Fable resets, no date given")
    alone = resets_output(local, {"peers": []}).splitlines()
    check("srq resets: a daemon with no peers lists its own",
          alone[-1] == f"totals: 2 week resets expire {md[week_ends]}; 2 Fable resets expire {md[fable_ends]}"
          and not any("peer" in ln for ln in alone))
    before_32 = resets_output(local, None)
    check("srq resets: a daemon before §32 lists its own and says the peers are not shown",
