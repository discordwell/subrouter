    def auto_row(i, mode="shadow", near_empty=True, claiming=False, **last):
        row = claude_row(i, True, "eligible")
        auto = {"mode": mode, "near_empty": near_empty}
        if claiming:
            auto["claiming"] = True
        if last:
            auto["last"] = {"at": decided_at, **last}
        row["auto_reset"] = auto
        return row

