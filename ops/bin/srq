    saved = {name: globals()[name] for name in ("_get", "_get_list", "remote_configs")}
    burn_answer = {"value": report}

    def fake_get(path):
        if path != BURN_PATH:
            raise SrqError(f"unexpected read of {path}")
        if isinstance(burn_answer["value"], int):
            raise SrqError(f"HTTP {burn_answer['value']}") from urllib.error.HTTPError(
                BASE + path, burn_answer["value"], "status", {}, None)
        return burn_answer["value"]

    def pool_output(*argv):
        out = io.StringIO()
        with contextlib.redirect_stdout(out):
            cmd_pool(list(argv))
        return out.getvalue()

    try:
        globals().update(_get=fake_get, _get_list=lambda path: [], remote_configs=lambda env=None: [])
        lines = pool_output().splitlines()
        check("srq pool ends with the one burn line", lines[-1] == burn_pool_line(report)
              and sum(ln.startswith("pool burn") for ln in lines) == 1)
        check("srq pool --json carries the report", json.loads(pool_output("--json"))["burn"] == report)
        check("srq pool --remote prints no burn line", "pool burn" not in pool_output("--remote"))
        burn_answer["value"] = 404
        check("a daemon from before §92 (404) reads as none",
              pool_output().splitlines()[-1] == burn_pool_line(None) and json.loads(pool_output("--json"))["burn"] is None)
        burn_answer["value"] = 500
        check("another failure is said, and the rest of srq pool still prints",
              pool_output().splitlines()[-1] == "pool burn: not read (HTTP 500)")
    finally:
        globals().update(saved)

    print()
    if failures:
        print(f"FAILED: {len(failures)}")
        return 1
    print("all regression fixtures pass")
    return 0


COMMANDS = {"serving": cmd_serving, "pool": cmd_pool, "dir": cmd_dir,
            "selftest": cmd_selftest, "resets": cmd_resets, "burn": cmd_burn}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd = COMMANDS.get(argv[0])
    if not cmd:
        print(f"unknown command {argv[0]!r}; try: {', '.join(COMMANDS)}", file=sys.stderr)
        return 2
    try:
        return cmd(argv[1:])
    except SrqError as e:
        print(f"srq: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
