          RESETS_FROM_CLAIM_LEGEND not in resets_output(local, peers) and "^" not in resets_output(local, peers))
    check("in how long, from a fixed now",
          _in_how_long(_instant(week_ends), _instant("2026-11-23T18:00:00Z")) == "in 17d 4h"
          and _in_how_long(_instant("2026-11-23T19:30:00Z"), _instant("2026-11-23T18:00:00Z")) == "in 1h 30m"
          and _in_how_long(_instant("2026-11-23T17:00:00Z"), _instant("2026-11-23T18:00:00Z")) == "ended 1h 0m ago")

    print("an account chosen for a reset is marked with its meter and order; srq resets shows each expiry window (PATCHES §95.3)")
    # Nothing showed which accounts a daemon runs to their limit for their next
    # saved reset, nor when a kind's expiry burndown starts.
    choice_why = "the pool needs its saved resets on the Claude week (...); a claim there adds 0.51 of a week (...)"

    def chosen_row(row, meter="week", order=1, mode="real", label=None):
        row = json.loads(json.dumps(row))
        choice = {"meter": meter, "order": order, "why": choice_why}
        if mode == "real":
            row["normalized"]["reset_choice"] = choice
        else:
            row["would_choose"] = choice
        return dict(row, label=label) if label else row

    loaded = [chosen_row(holder_row(0, True, "chosen", live_sessions=3, allowed_sessions=20), label="alpha@example.com"),
              chosen_row(holder_row(1, False, "at_cap", live_sessions=20, allowed_sessions=20), order=2),
              chosen_row(holder_row(2, True, "eligible"), meter="fable"),
              holder_row(3, True, "eligible")]
