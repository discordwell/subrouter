              "count": 3, "kind": "week", "expires_on": md[week_ends], "expiry": None}])
    claimed = [listing(dict(holder_row(0, True, "eligible"), label="alpha@example.com"), [held("fable", 1, fable_ends)],
                       resets_from_claim=True)]
