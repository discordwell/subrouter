    import datetime
    now = datetime.datetime.now(datetime.timezone.utc)
    soon, later = now + datetime.timedelta(hours=20), now + datetime.timedelta(days=17)
    opened, opens = now - datetime.timedelta(hours=4), now + datetime.timedelta(days=14, hours=3, minutes=30)
    iso = lambda when: when.strftime("%Y-%m-%dT%H:%M:%SZ")
    window = lambda when: {"opens_at": iso(when), "lead_seconds": 86400, "why": "3 holders have 1.4 weeks ..."}
