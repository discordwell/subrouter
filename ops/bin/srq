                  ["resets"][0]["expiry_window"] for bad in ("open", {"opens_at": "soon"}, {"lead_seconds": 86400}, [])))

    print("srq burn words the pool's burn, its trend and the share at the limit; srq pool has one line (PATCHES §92.2)")
    import contextlib, io

    def figure(burn=None, covered=1.0, at_limit=0.0):
        out = {"covered": covered}
        if burn is not None:
            out["burn"] = burn
            if at_limit:
                out["at_limit"] = at_limit
        return out

    def pool_window(burn, counted, few=0, at_limit=0.0):
        return {"burn": burn, "accounts": counted, "not_enough_history": few,
                "at_limit": at_limit if burn is not None else None}

    report = {
        "generated_at": "2026-11-23T08:00:00Z",
        "meters": [
            {"provider": "claude", "meter": "week", "label": "Claude week",
             "windows": {"1h": pool_window(1.12, 2), "6h": pool_window(0.95, 2, at_limit=0.05),
                         "24h": pool_window(0.8, 1, few=1, at_limit=0.4)},
             "trend": {"6h": {"change": 0.2, "accounts": 2}, "24h": {"change": None, "accounts": 0}},
             "accounts": [
                 {"pool": "local", "id": "seat-a", "label": "alpha",
                  "windows": {"1h": figure(1.3), "6h": figure(0.95), "24h": figure(0.8, at_limit=0.4)}},
                 {"pool": "box", "id": "codex-owner-0123456789abcdef01",
