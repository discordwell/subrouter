    check("a meter no account reads says so", "\nClaude Fable: no account reads this meter\n" in text)
    check("a meter with no figures yet says not enough history yet, window by window",
          "\nCodex week\n  last hour      not enough history yet\n  last 6 hours   not enough history yet\n"
          "  last 24 hours  not enough history yet\n" in text)
    check("an uncounted peer is named, with why, and its accounts are not read as 0",
