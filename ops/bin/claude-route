JSON
    fake_daemon serve "$tmp/fixture.json"; local FT="http://127.0.0.1:$FAKE_PORT"
    mkdir -p "$tmp/fh"
    fdry() { local tcp="$1"; shift; dry PATH="$P_SHIM" CLAUDE_ROUTE_HOME="$tmp/fh" CLAUDE_ROUTE_TCP="$tcp" CLAUDE_ROUTE_SOCKET=/nonexistent/claude.sock "$@"; }
    if [ -z "$FAKE_PORT" ]; then check "the stand-in daemon started" false; else
    o=$(fdry "$FT" CLAUDE_ROUTE_PLIST="$(mkplist fx-ident)" "$SHIM" FX-IDENT -p hi)
    check "the identity account: pinned"                                has "$o" "route=pool-tcp" "pin=fx-ident at=local" "X-Subrouter-Account-ID: fx-ident" "args=[-p][hi]"
    o=$(fdry "$FT" CLAUDE_ROUTE_PLIST="$(mkplist fx-ident)" "$SHIM" fx-ident@example.invalid)
