    o=$(fdry "$FT" CLAUDE_ROUTE_PLIST="$(mkplist fx-ident)" "$SHIM" fx-other); rc=$?
    check "another laptop account: refused while /api/* follows the pin (2)" eval 'code_is $rc 2 && has "$o" "refused=not-identity"'
