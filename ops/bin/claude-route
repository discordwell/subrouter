    o=$(fdry "$FT/pins" CLAUDE_ROUTE_PLIST="$(mkplist fx-ident)" "$SHIM" fx-other)
    check "  ...allowed once the daemon keeps /api/* on its identity"   has "$o" "route=pool-tcp" "pin=fx-other at=local"
    o=$(fdry "$FT" CLAUDE_ROUTE_PLIST="$(mkplist fx-paid)" "$SHIM" fx-paid); rc=$?
    check "spent and able to bill extra usage: refused (2)"             eval 'code_is $rc 2 && has "$o" "refused=paid-overflow" "CLAUDE_ROUTE_ALLOW_PAID=1"'
    o=$(fdry "$FT" CLAUDE_ROUTE_PLIST="$(mkplist fx-paid)" CLAUDE_ROUTE_ALLOW_PAID=1 "$SHIM" fx-paid)
    check "  ...CLAUDE_ROUTE_ALLOW_PAID=1 accepts it, with a note"      has "$o" "route=pool-tcp" "pin=fx-paid" "note=" "bill past its plan"
    o=$(fdry "$FT" CLAUDE_ROUTE_PLIST="$(mkplist fx-spent)" "$SHIM" fx-spent)
    check "spent, no paid overflow: pinned, with the limit note"        has "$o" "route=pool-tcp" "pin=fx-spent" "note=" "limit error, never another account"
    o=$(fdry "$FT" CLAUDE_ROUTE_PLIST="$(mkplist fx-nousage)" "$SHIM" fx-nousage); rc=$?
    check "no usage verdict: refused (2)"                               eval 'code_is $rc 2 && has "$o" "refused=unverified"'
    o=$(fdry "$FT" CLAUDE_ROUTE_PLIST="$(mkplist fx-spent-unknown)" "$SHIM" fx-spent-unknown); rc=$?
    check "spent, and whether it can bill extra usage unknown: refused (2)" eval 'code_is $rc 2 && has "$o" "refused=unverified"'
    o=$(fdry "$FT" CLAUDE_ROUTE_PLIST="$(mkplist fx-fresh-unknown)" "$SHIM" fx-fresh-unknown)
    check "  ...but an eligible one is pinned"                          has "$o" "route=pool-tcp" "pin=fx-fresh-unknown at=local"
    o=$(fdry "$FT" CLAUDE_ROUTE_PLIST="$(mkplist fx-ident)" "$SHIM" fx-dup); rc=$?
    check "one word, a laptop account and a different peer one: refused (2)" eval 'code_is $rc 2 && has "$o" "refused=ambiguous"'
    o=$(fdry "$FT" CLAUDE_ROUTE_PLIST="$(mkplist fx-ident)" "$SHIM" fx-peer); rc=$?
    check "a peer account without peer pins: refused (2)"               eval 'code_is $rc 2 && has "$o" "refused=peer-pins-unsupported"'
    o=$(fdry "$FT/pins" CLAUDE_ROUTE_PLIST="$(mkplist fx-ident)" "$SHIM" fx-peer)
    check "  ...pinned once the daemon advertises peer pins"            has "$o" "route=pool-tcp" "pin=fx-peer at=fxbox" "X-Subrouter-Account-ID: fx-peer"
    o=$(fdry "$FT/pins" CLAUDE_ROUTE_PLIST="$(mkplist fx-ident)" "$SHIM" fx-peer-paid); rc=$?
    check "  ...but never a spent one that can bill extra usage (2)"    eval 'code_is $rc 2 && has "$o" "refused=paid-overflow"'
    o=$(fdry "$FT" CLAUDE_ROUTE_PLIST="$(mkplist fx-ident)" "$SHIM" fx-identt); rc=$?
    check "a typo of an account name sends nothing (2)"                 eval 'code_is $rc 2 && has "$o" "refused=near" "fx-ident"'
    o=$(fdry "$FT" CLAUDE_ROUTE_PLIST="$(mkplist fx-ident)" CLAUDE_ROUTE=pool "$SHIM" fxplan)
    check "a plain one-word prompt near an account name stays a prompt" has "$o" "word=<none>" "args=[fxplan]"
    if [ -x "$CSHIM" ]; then
        o=$(cdry PATH="$P_SHIM" CLAUDE_ROUTE_HOME="$tmp/fh" CLAUDE_ROUTE_TCP="$FT" "$CSHIM" fxcx1@example.invalid exec hi); rc=$?
        ccheck "codex: spent and holding credits: refused (2)"            eval 'code_is $rc 2 && has "$o" "refused=paid-overflow" "CODEX_ROUTE_ALLOW_PAID=1"'
        o=$(cdry PATH="$P_SHIM" CLAUDE_ROUTE_HOME="$tmp/fh" CLAUDE_ROUTE_TCP="$FT" CODEX_ROUTE_ALLOW_PAID=1 "$CSHIM" fxcx1@example.invalid exec hi)
        ccheck "  ...CODEX_ROUTE_ALLOW_PAID=1 accepts it"                 has "$o" "route=pool" "\"X-Subrouter-Account-ID\"=\"codex-owner-fxcx1\""
        o=$(cdry PATH="$P_SHIM" CLAUDE_ROUTE_HOME="$tmp/fh" CLAUDE_ROUTE_TCP="$FT" "$CSHIM" fxcx2 exec hi)
        ccheck "codex: eligible with credits, by email name: pinned, with a note" has "$o" "route=pool" "pin=codex-owner-fxcx2 at=local" "note=" "credits"
    fi
    fi
    fake_daemon stall /dev/null; local ST="http://127.0.0.1:$FAKE_PORT"
    mkdir -p "$tmp/sh"; cp "$tmp/fh/accounts.tsv" "$tmp/sh/accounts.tsv" 2>/dev/null; touch -t 202601010000 "$tmp/sh/accounts.tsv" 2>/dev/null
    if [ -z "$FAKE_PORT" ]; then check "the hung stand-in daemon started" false; else
    t0=$(date +%s); o=$(dry PATH="$P_SHIM" CLAUDE_ROUTE_HOME="$tmp/sh" CLAUDE_ROUTE_TCP="$ST" CLAUDE_ROUTE_SOCKET=/nonexistent/claude.sock CLAUDE_ROUTE=pool "$SHIM" hello-zz -p x)
    check "a hung daemon and an old list: a one-word prompt stays a prompt, fast" eval 'has "$o" "word=<none>" "route=off" "args=[hello-zz][-p][x]" && quick $t0 8'
    t0=$(date +%s); o=$(dry PATH="$P_SHIM" CLAUDE_ROUTE_HOME="$tmp/sh" CLAUDE_ROUTE_TCP="$ST" CLAUDE_ROUTE_SOCKET=/nonexistent/claude.sock "$SHIM" fx-ident); rc=$?
    check "  ...and a pin is refused as daemon-down (75), fast"          eval 'code_is $rc 75 && has "$o" "refused=daemon-down" && quick $t0 8'
    fi

    echo "== route words: the account directory and its neighbours =="
    check "no account word is a Claude Code or Codex command, or 'local'; none names two accounts" \
        directory_report "$ACCOUNTS" "$ALIASES" "$(shim_list "$SHIM" reserved)" "$(shim_list "$CSHIM" codex_cmds)"
    check "every 'claude --help' command is reserved in the shim" eval '"$HOME/.local/bin/claude" --help 2>/dev/null | python3 -I -c "
import re,sys
cmds=set()
for m in re.finditer(r\"^  ([a-z][a-z-]*)((?:\\|[a-z-]+)*)\", sys.stdin.read().split(\"Commands:\")[-1], re.M):
    cmds.add(m.group(1)); cmds.update(x for x in m.group(2).split(\"|\") if x)
miss=sorted(cmds-set(sys.argv[1].split())); print(\"claude commands not reserved:\", miss or \"none\"); sys.exit(1 if miss or not cmds else 0)" "$(shim_list "$SHIM" reserved)"'
    [ -x "$CSHIM" ] && ccheck "every 'codex --help' command is reserved in the codex shim" eval '"$(real_codex)" --help 2>/dev/null | python3 -I -c "
import re,sys
text=sys.stdin.read().split(\"Commands:\")[-1].split(\"Arguments:\")[0]
cmds=set()
for m in re.finditer(r\"^  ([a-z][a-z-]*)\s.*?(?:\[aliases: ([a-z, -]+)\])?$\", text, re.M):
    cmds.add(m.group(1)); cmds.update(x.strip() for x in (m.group(2) or \"\").split(\",\") if x.strip())
miss=sorted(cmds-set(sys.argv[1].split())); print(\"codex commands not reserved:\", miss or \"none\"); sys.exit(1 if miss or not cmds else 0)" "$(shim_list "$CSHIM" codex_cmds)"'
    check "Paradev's presets still put a flag first (claude) and the prompt after -- (codex)" eval 'perl -e "alarm 30; exec @ARGV" paradev agents list --local --json 2>/dev/null | python3 -I -c "
import json,sys
p={a[\"presetId\"]:a for a in json.load(sys.stdin)}
ok=p[\"claude\"][\"args\"][0].startswith(\"-\") and p[\"codex\"][\"promptArgs\"]==[\"--\"]
sys.exit(0 if ok else 1)"'

    if [ -x "$CSHIM" ]; then
    echo "== route words: codex (dry run; recorded in last-codex-test) =="
    local cbefore; cbefore=$(stat -f '%i %m %z' "$HOME/.codex/auth.json" 2>/dev/null)
    o=$(cdry PATH="$P_SHIM" CODEX_ROUTE=off "$CSHIM"); ccheck "codex: resolves the real binary, not a shim or Paradev's" eval 'has "$o" "real=/" && lacks "$o" "real=$SHIM_DIR/" "/.paradev/bin/"'
    o=$(cdry PATH="$P_SHIM" CODEX_ROUTE=off OPENAI_BASE_URL="$TCP/v1" "$CSHIM" exec hi)
    ccheck "codex off (no word): untouched"                           has "$o" "route=off" "args=[exec][hi]" "OPENAI_BASE_URL=$TCP/v1"
    o=$(cdry PATH="$P_SHIM" CODEX_ROUTE=pool "$CSHIM" exec --skip-git-repo-check hi)
    ccheck "codex pool: the subrouter provider block, after the prompt" has "$o" "route=pool" "[-c][model_provider=\"subrouter\"][-c][model_providers.subrouter={name=\"Subrouter\",base_url=\"$TCP/v1\",experimental_bearer_token=\"subrouter\",wire_api=\"responses\",supports_websockets=true,http_headers={\"X-Subrouter-Agent\"=\"codex\"}}]"
    o=$(cdry PATH="$P_SHIM" CODEX_ROUTE=pool "$CSHIM" --dangerously-bypass-approvals-and-sandbox -- "fix it")
    ccheck "  ...the block goes before --; the prompt stays last"      has "$o" "}}][--][fix it]"
    o=$(cdry PATH="$P_PARADEV" CODEX_ROUTE=pool OPENAI_BASE_URL="$TCP/v1" "$HOME/.paradev/bin/codex" local)
    ccheck "codex local through Paradev's wrapper: prefix kept, word dropped, subrouter URL dropped" has "$o" "route=off" "word=local" "args=[--enable][hooks][--dangerously-bypass-hook-trust]" "OPENAI_BASE_URL=<unset>"
    o=$(cdry PATH="$P_SHIM" CODEX_ROUTE=pool "$CSHIM" -c 'projects={"/x"={trust_level="trusted"}}' --enable hooks --dangerously-bypass-hook-trust LOCAL)
    ccheck "  ...and with Paradev's project-trust -c in front"         has "$o" "route=off" "word=local"
    o=$(cdry PATH="$P_PARADEV" CODEX_ROUTE=pool "$HOME/.paradev/bin/codex" --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust -- local)
    ccheck "Paradev's Codex preset shape (-- prompt) is never a word"  has "$o" "route=pool" "word=<none>" "[--][local]"
    local c
    for c in login logout "mcp list" app-server --version; do
        o=$(cdry PATH="$P_SHIM" CODEX_ROUTE=pool "$CSHIM" $c); ccheck "codex $c: the real binary, untouched" has "$o" "route=passthrough" "args=[${c// /][}]"
    done
    o=$(cdry PATH="$P_SHIM" CODEX_ROUTE=pool "$CSHIM" local login); ccheck "codex local login: the real binary" has "$o" "route=passthrough" "args=[login]"
    o=$(cdry PATH="$P_SHIM" CODEX_HOME="$HOME/.subrouter/codex/zz-store" "$CSHIM" login); rc=$?
    ccheck "codex login with CODEX_HOME in a pool store: refused (2)"  eval 'code_is $rc 2 && has "$o" "refused=pool-store-home"'
    o=$(cdry PATH="$P_SHIM" CODEX_HOME="$HOME/.subrouter/codex/zz-store" CODEX_ROUTE=pool "$CSHIM" exec hi); rc=$?
    ccheck "  ...and a pooled session there (2)"                       eval 'code_is $rc 2 && has "$o" "refused=pool-store-home"'
    o=$(cdry PATH="$P_SHIM" CODEX_HOME="$HOME/.subrouter/codex/zz-store" "$CSHIM" local exec hi)
    ccheck "  ...codex local drops it: your own ~/.codex"              has "$o" "route=off" "CODEX_HOME=<unset>" "note=CODEX_HOME pointed into ~/.subrouter"
    o=$(cdry PATH="$P_SHIM" CODEX_ROUTE=pool "$CSHIM" exec -c 'model_provider="subrouter"' hi)
    ccheck "sr codex / cx arguments are kept as they are"              has "$o" "route=inherited" "args=[exec][-c][model_provider=\"subrouter\"][hi]"
    local p
    for p in add reset isolation-check; do
        o=$(cdry PATH="$P_SHIM" CODEX_ROUTE=pool "$CSHIM" "$p"); ccheck "'codex $p' is a prompt to Codex, never an sr account command" has "$o" "route=pool" "args=[$p][-c]"
    done
    o=$(cdry PATH="$P_SHIM" "$CSHIM" locl); rc=$?;                   ccheck "codex: a typo of 'local' sends nothing (2)" eval 'code_is $rc 2 && has "$o" "refused=near"'
    o=$(cdry PATH="$P_SHIM" CODEX_ROUTE=pool CLAUDE_ROUTE_TCP=http://127.0.0.1:9 "$CSHIM" exec hi)
    ccheck "codex pool, daemon dead: own login with a note"           has "$o" "route=off" "note=the subrouter daemon is not answering"
    if [ -n "$LX" ]; then
        o=$(cdry PATH="$P_SHIM" "$CSHIM" "$LX" exec hi)
        case "$o" in
            *route=refused*) ccheck "codex '$LX': refused before launch ($(printf '%s\n' "$o" | sed -n 's/^refused=//p'))" has "$o" "refused=" ;;
            *) ccheck "codex pinned by id: the pin header in the block" has "$o" "route=pool" "pin=$LX at=local" "\"X-Subrouter-Account-ID\"=\"$LX\"" ;;
        esac
        o=$(cdry PATH="$P_SHIM" CLAUDE_ROUTE_TCP=http://127.0.0.1:9 "$CSHIM" "$LX" exec hi); rc=$?
        ccheck "  ...daemon dead: refused (75)"                         eval 'code_is $rc 75'
        o=$(cdry PATH="$P_SHIM" "$CSHIM" "$LX" login); rc=$?;          ccheck "  ...a pin on login is refused (2)" eval 'code_is $rc 2'
        o=$(cdry PATH="$P_SHIM" "$CSHIM" "$LX" -c 'model_provider="x"' exec hi); rc=$?; ccheck "  ...a pin plus a provider -c is refused (2)" eval 'code_is $rc 2'
    fi
    if [ -n "$PX" ]; then
        o=$(cdry PATH="$P_SHIM" "$CSHIM" "$PX" exec hi); rc=$?
        if [[ "$hbl" =~ \"account_pins\"[[:space:]]*:[[:space:]]*\"local\+peers\" ]]; then ccheck "codex peer account '$PX': pinned through the laptop" has "$o" "pin=$PX"
        else ccheck "codex peer account '$PX': refused on a build without peer pins (2)" eval 'code_is $rc 2 && has "$o" "refused=peer-pins-unsupported"'; fi
    fi
    [ -n "$PC" ] && { o=$(cdry PATH="$P_SHIM" "$CSHIM" "$PC" exec hi); rc=$?; ccheck "a Claude account ('$PC') to codex is refused (2)" eval 'code_is $rc 2 && has "$o" "refused=other"'; }
    ccheck "codex --version through the shim equals the real binary's" eval '[ "$(cd "$cwd" && env "${clean[@]}" PATH="$P_SHIM" CODEX_ROUTE=off "$CSHIM" --version 2>&1)" = "$("$(real_codex)" --version 2>&1)" ]'
    ccheck "neither shim names Codex's auth file"                     eval '! $GREP -q "auth\.json" "$SHIM" "$CSHIM"'

    echo "== codex real launches (throwaway CODEX_HOME: ~/.codex is never written) =="
    mkdir -p "$tmp/codex-home" "$tmp/codex-cwd"; $GREP -E '^(model|model_reasoning_effort) *=' "$HOME/.codex/config.toml" > "$tmp/codex-home/config.toml" 2>/dev/null
    cx() { # the command; the final message must be exactly $CX_WANT. Sets CX_SID (Codex's session id = the daemon's)
        local out last; rm -f "$tmp/cx-last.txt"
        # stdin from /dev/null: `codex exec` waits on an open non-terminal stdin. Paradev's codex wrapper
        # runs codex as a CHILD, so the timeout kills the whole process group, not just the wrapper.
        out=$(cd "$tmp/codex-cwd" && run_group 180 env "${clean[@]}" CODEX_HOME="$tmp/codex-home" "$@" -o "$tmp/cx-last.txt" </dev/null 2>&1)
        CX_SID=$(printf '%s\n' "$out" | sed -n 's/^session id: //p' | head -1); last=$(cat "$tmp/cx-last.txt" 2>/dev/null)
        echo "[codex $CX_SID] -> ${last:0:200}"
        [ "$(printf '%s' "$last" | tr -d '[:space:].' | tr '[:upper:]' '[:lower:]')" = "$CX_WANT" ]
    }
    CX_WANT=echo; ccheck "codex pool exec answers"                       cx PATH="$P_SHIM" CODEX_ROUTE=pool "$CSHIM" exec --skip-git-repo-check "Reply with exactly one word, in lowercase: echo"
    ccheck "  ...and the pool served it"                                  eval 'served "$CX_SID"'
    if [ -n "$LX" ] && [[ "$(cdry PATH="$P_SHIM" "$CSHIM" "$LX" exec hi)" == *route=pool* ]]; then
        CX_WANT=foxtrot; ccheck "codex pinned through Paradev's wrapper answers" cx PATH="$P_PARADEV" "$HOME/.paradev/bin/codex" "$LX" exec --skip-git-repo-check "Reply with exactly one word, in lowercase: foxtrot"
        ccheck "  ...on exactly that account"                              eval 'served "$CX_SID" && test "$SERVED_BY" = "$LX"'
    fi
    ccheck "~/.codex auth file untouched (inode, mtime, size)"            test "$(stat -f '%i %m %z' "$HOME/.codex/auth.json" 2>/dev/null)" = "$cbefore"
    else
        echo "== codex: shim not installed; codex checks skipped =="
    fi

    echo "== route words: real launches (haiku) =="
    local w1 w2 w3 w4 w5 w6; w1=$(uuid); w2=$(uuid); w3=$(uuid); w4=$(uuid); w5=$(uuid); w6=$(uuid)
    escaped() { # claude -p -- local: Claude Code gets the word as the prompt (its transcript's first user message)
        (cd "$cwd" && perl -e 'alarm 240; exec @ARGV' env "${clean[@]}" PATH="$P_SHIM" CLAUDE_ROUTE=pool "$SHIM" -p --model haiku --session-id "$w1" -- local >/dev/null 2>>"$err") || return 1
        local f; f=$(ls "$HOME"/.claude/projects/*/"$w1".jsonl 2>/dev/null | head -1)
        [ -n "$f" ] && python3 -I -c 'import json,sys
for l in open(sys.argv[1]):
    d=json.loads(l)
    if d.get("type")=="user": sys.exit(0 if d.get("message",{}).get("content")=="local" else 1)
sys.exit(1)' "$f"
    }
    check "'claude -p -- local' sends the word as the prompt"           escaped
    check "'claude local' answers on your own login"                     ask "$w4" juliet PATH="$P_PARADEV" "$HOME/.paradev/bin/claude" local
    check "  ...logged route=off word=local, and the daemon never saw it" eval '$GREP -F "sid=$w4" "$ROUTE_HOME/launch.log" | $GREP -q "route=off word=local" && unserved "$w4"'
    if [ -n "$LC" ]; then
        o=$(dry PATH="$P_SHIM" "$SHIM" "$LC")
        if [[ "$o" == *route=refused* ]]; then
            t0=$(date +%s)
            check "pinned '$LC': refused before launch, nothing sent" eval '(cd "$cwd" && env "${clean[@]}" PATH="$P_SHIM" "$SHIM" "$LC" -p hi --session-id "$w2" >/dev/null 2>&1); code_is $? 2 && quick $t0 10 && unserved "$w2"'
        elif [[ "$o" == *flags=*ineligible* ]]; then
            t0=$(date +%s)
            check "pinned '$LC' (spent) fails fast with the provider's limit, no failover" eval '! ask "$w2" hotel PATH="$P_PARADEV" "$HOME/.paradev/bin/claude" "$LC" && quick $t0 45 && served "$w2" && test "$SERVED_BY" = "$LC"'
        else
            check "pinned '$LC' answers"                                  ask "$w2" hotel PATH="$P_PARADEV" "$HOME/.paradev/bin/claude" "$LC"
            check "  ...on exactly that account"                          eval 'served "$w2" && test "$SERVED_BY" = "$LC"'
        fi
    fi
    if [ -n "$PC" ]; then
        if [[ "$hbl" =~ \"account_pins\"[[:space:]]*:[[:space:]]*\"local\+peers\" ]]; then
            check "a peer pin ('$PC') answers through the laptop"        ask "$w3" india PATH="$P_SHIM" "$SHIM" "$PC"
            check "  ...on exactly that account, on the peer"             eval 'served "$w3" && [[ "$SERVED_BY" == "$PC on "*"[remote]"* ]]'
        else
            t0=$(date +%s)
            check "a peer pin ('$PC') on this build: exit 2 at once, nothing sent" eval '(cd "$cwd" && env "${clean[@]}" PATH="$P_SHIM" "$SHIM" "$PC" -p hi --session-id "$w3" >/dev/null 2>&1); code_is $? 2 && quick $t0 10 && unserved "$w3"'
        fi
    fi
    # Resuming across routes: a pool session's signed thinking on your own login, and back.
    check "a pool session (with thinking) resumes under 'claude local'"  eval 'ask "$w5" kilo PATH="$P_SHIM" MAX_THINKING_TOKENS=2048 CLAUDE_ROUTE=pool "$SHIM" && served "$w5" && resume "$w5" lima PATH="$P_SHIM" MAX_THINKING_TOKENS=2048 "$SHIM" local'
    check "an own-login session (with thinking) resumes on the pool"      eval 'ask "$w6" mike PATH="$P_SHIM" MAX_THINKING_TOKENS=2048 "$SHIM" local && unserved "$w6" && resume "$w6" november PATH="$P_SHIM" MAX_THINKING_TOKENS=2048 CLAUDE_ROUTE=pool "$SHIM" && served "$w6"'

    echo "== real launches through the shim (haiku) =="
    local s1 s2 s3 s4 s5; s1=$(uuid); s2=$(uuid); s3=$(uuid); s4=$(uuid); s5=$(uuid)
    check "pool -p answers"                                ask "$s1" pong PATH="$P_SHIM" CLAUDE_ROUTE=pool "$SHIM"
    check "  ...and the pool served it"                    served "$s1"
    local first_account="$SERVED_BY"
    check "pool via Paradev's wrapper answers"             ask "$s2" ping PATH="$P_PARADEV" CLAUDE_ROUTE=pool "$HOME/.paradev/bin/claude"
    check "  ...and the pool served it"                    served "$s2"
    check "pool --resume answers"                          resume "$s1" again PATH="$P_SHIM" CLAUDE_ROUTE=pool "$SHIM"
    check "  ...on the same pinned account"                eval 'served "$s1" && test "$SERVED_BY" = "$first_account"'
    ( ask "$s3" alpha PATH="$P_SHIM" CLAUDE_ROUTE=pool "$SHIM" >>"$err" 2>&1; echo $? > "$tmp/t3" ) &
    local j3=$!
    ( ask "$s4" bravo PATH="$P_SHIM" CLAUDE_ROUTE=pool "$SHIM" >>"$err" 2>&1; echo $? > "$tmp/t4" ) &
    local j4=$!
    wait "$j3" "$j4"
    check "two concurrent pool launches both answer"      eval 'test "$(cat "$tmp/t3")" = 0 && test "$(cat "$tmp/t4")" = 0'
    check "  ...and the pool served both"                  eval 'served "$s3" && served "$s4"'
    check "dead socket falls back to TCP and answers"      ask "$s5" delta PATH="$P_SHIM" CLAUDE_ROUTE=pool CLAUDE_ROUTE_SOCKET=/nonexistent/claude.sock "$SHIM"
    check "  ...through the pool"                          served "$s5"
    check "off execs the real binary"                      eval '[ "$(cd "$cwd" && env "${clean[@]}" PATH="$P_SHIM" CLAUDE_ROUTE=off "$SHIM" --version 2>&1)" = "$(env "${clean[@]}" "$HOME/.local/bin/claude" --version 2>&1)" ]'

    echo "== parity: a pool session must look like a signed-in one =="
    check "pool offers every tool off does (claude.ai connectors excepted)" parity
    [ -n "${PARITY_MISSING:-}" ] && echo "        pool lacks: $PARITY_MISSING"
    [ -n "${PARITY_KNOWN:-}" ] && echo "        accepted gap (claude.ai connectors): $PARITY_KNOWN"

    echo "== a fresh terminal =="
    check "a new login shell finds the shim first"         eval '[ "$(env -i HOME="$HOME" USER="$USER" TERM=dumb SHELL=/bin/zsh perl -e "alarm 30; exec @ARGV" /bin/zsh -l -i -c "command -v claude" 2>/dev/null | tail -1)" = "$SHIM" ]'
    [ -x "$CSHIM" ] && ccheck "  ...and the codex shim first"      eval '[ "$(env -i HOME="$HOME" USER="$USER" TERM=dumb SHELL=/bin/zsh perl -e "alarm 30; exec @ARGV" /bin/zsh -l -i -c "command -v codex" 2>/dev/null | tail -1)" = "$CSHIM" ]'

    local f; for f in "${fakes[@]}"; do { kill "$f"; wait "$f"; } 2>/dev/null; done
    rm -rf "$tmp"
    echo "== claude: $pass passed, $fail failed;  codex: $cpass passed, $cfail failed =="
    if [ "$fail" = 0 ]; then echo "PASS $(date +%Y-%m-%d) $(date +%H:%M:%S) ($pass checks)" > "$LAST_TEST"
    else echo "FAIL $(date +%Y-%m-%d) $(date +%H:%M:%S) ($fail of $((pass+fail)) failed)" > "$LAST_TEST"; fi
    if [ -x "$CSHIM" ]; then
        if [ "$cfail" = 0 ]; then echo "PASS $(date +%Y-%m-%d) $(date +%H:%M:%S) ($cpass checks)" > "$LAST_CODEX_TEST"
        else echo "FAIL $(date +%Y-%m-%d) $(date +%H:%M:%S) ($cfail of $((cpass+cfail)) failed)" > "$LAST_CODEX_TEST"; fi
    fi
    [ "$fail" = 0 ] && [ "$cfail" = 0 ]
}

case "${1:-status}" in
    status) cmd_status ;;
    install) cmd_install ;;
    uninstall) cmd_uninstall ;;
    accounts) cmd_accounts ;;
    socket-on) cmd_socket_on "${2:-}" ;;
    socket-off) shift; cmd_socket_off "$@" ;;
    test) cmd_test ;;
    check) cmd_check "${2:-}" ;;
    pool) cmd_pool "${2:-}" ;;
    off) cmd_off ;;
    codex) cmd_codex "${2:-}" "${3:-}" ;;
    help|-h|--help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0" ;;
    *) die "unknown command '$1' (try: claude-route help)" ;;
esac
