#!/usr/bin/env python3
"""srdash -- one page showing every subrouter pool you can reach.

Local daemon and every server in ~/.subrouter/codex/servers.json, both providers,
side by side. Answers the questions you actually open a dashboard for: how much
is left, where, and is `sr claude` about to spill to the box.

  srdash                 serve on 127.0.0.1:31416 and open a browser
  srdash --port 8080     different port
  srdash --no-open       don't open a browser
  srdash --once          print the JSON payload and exit (no server)

Account rows come from srq.summarize() rather than a local reimplementation.
That function is the one place the provider-specific window vocabulary is
resolved (claude "7d" vs codex "primary"), and reimplementing it is exactly how
five untouched Pro accounts once got reported as exhausted. If you need a new
field, add it there, not here.

Nothing here mutates anything: two GETs per daemon, no CLI invocation. It never
runs `sr`, so it cannot switch your active account.
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
import sys
import threading
import time
import urllib.error
import urllib.request
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

LOCAL_BASE = "http://127.0.0.1:31415"
SERVERS_JSON = os.path.expanduser("~/.subrouter/codex/servers.json")
TIMEOUT = 8

# Routability is the DAEMON'S answer, read from each account's `usable` field
# rather than reconstructed here. There is no flat headroom floor to mirror any
# more, and every previous attempt to keep a local copy in sync eventually
# disagreed with the router.
#
# The meter colours are presentation bands and live with the markup that draws
# them; they are deliberately NOT mirrored here as constants nothing reads.


def load_srq():
    """Import the sibling srq script as a module (it has no .py extension)."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "srq")
    if not os.path.exists(path):
        raise SystemExit(f"srdash: cannot find srq next to me at {path}")
    spec = importlib.util.spec_from_loader(
        "srq", importlib.machinery.SourceFileLoader("srq", path)
    )
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


SRQ = load_srq()


def discover_daemons():
    """Local daemon first, then every configured server.

    Servers are read from disk rather than hardcoded so a second box shows up
    without touching this file. Tokens stay in this process; they are never sent
    to the browser.
    """
    daemons = [{"name": "local", "base": LOCAL_BASE, "token": "", "is_local": True}]
    try:
        with open(SERVERS_JSON) as fh:
            config = json.load(fh)
    except (OSError, ValueError):
        return daemons
    default_name = config.get("defaultServer") or config.get("default") or ""
    for server in config.get("servers") or []:
        url = (server.get("url") or "").strip()
        if not url:
            continue
        daemons.append({
            "name": server.get("name") or url,
            "base": url.rstrip("/"),
            # Admin token, because usage-status is admin-gated off loopback.
            "token": (server.get("adminToken") or "").strip(),
            "is_local": False,
            "is_default": (server.get("name") == default_name),
        })
    return daemons


def fetch(base, token, path):
    request = urllib.request.Request(f"{base}{path}")
    if token:
        request.add_header("Authorization", f"Bearer {token}")
    with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
        return json.load(response)


def floor_state(norm):
    """The ROUTER'S verdict on whether it would start a new session here.

    Read, not recomputed. This file used to carry its own copy -- first a flat
    0.40 floor, then a transcription of the burn projection -- and a copy is a
    thing that drifts. The flat-floor version had this dashboard printing
    "0/6 above floor" for a pool the daemon was routing to happily, and the
    transcription needed short_window_seconds, which an older peer does not
    even send.

    Returns None when unknown. Unknown is never 'clears' and never 'fails':
    the Go side treats an absent normalized block as unknown and stays local
    rather than assuming capacity, so neither may this.
    """
    if not isinstance(norm, dict):
        return None
    usable = norm.get("usable")
    if isinstance(usable, bool):
        return usable
    # A daemon too old to publish its verdict. Unknown, not a guess -- guessing
    # is what this function is being cured of.
    return None


def read_pool(daemon):
    """One daemon's pool, or a reachability error.

    A daemon being unreachable is the normal case, not an exception: the box is
    only there when Tailscale is up. It renders as an offline card.
    """
    out = {
        "name": daemon["name"],
        "base": daemon["base"],
        "is_local": daemon["is_local"],
        "is_default": daemon.get("is_default", False),
        "online": False,
        "error": None,
        "accounts": [],
    }
    # A tailnet link that has gone idle can time out its first packet while the
    # direct path is re-established, and the retry then lands in ~100ms. Treating
    # that single timeout as "offline" made claudemode pick the wrong pool. Only
    # transport errors are retried -- an HTTP status is a real answer.
    rows = None
    last = None
    for attempt in range(2):
        try:
            rows = fetch(daemon["base"], daemon["token"], "/_subrouter/usage-status")
            break
        except urllib.error.HTTPError as e:
            out["error"] = (
                "401 -- needs an admin token (this daemon is not on loopback)"
                if e.code == 401 else f"HTTP {e.code}"
            )
            return out
        except (urllib.error.URLError, OSError) as e:
            last = f"unreachable: {getattr(e, 'reason', e)}"
        except ValueError as e:
            out["error"] = f"bad response: {e}"
            return out
        if attempt == 0:
            time.sleep(0.4)
    if rows is None:
        out["error"] = last or "unreachable"
        return out

    out["online"] = True
    for row in rows or []:
        summary = SRQ.summarize(row)
        norm = row.get("normalized") if isinstance(row.get("normalized"), dict) else {}
        # A 5h figure only where the row has a 5h window. Without one,
        # short_headroom is a stand-in, not a meter: the week on Codex, 1 on a
        # Claude account with no 5h reading.
        summary["short_percent"] = (
            None if norm.get("short_headroom") is None or summary.get("short_used_percent") is None
            else round(norm["short_headroom"] * 100)
        )
        summary["weekly_percent"] = (
            None if norm.get("weekly_headroom") is None
            else round(norm["weekly_headroom"] * 100)
        )
        summary["clears_floor"] = floor_state(norm)
        out["accounts"].append(summary)
    out["accounts"].sort(key=lambda a: (a.get("provider") or "", a.get("name") or ""))
    return out


def build_payload():
    daemons = discover_daemons()
    pools = [None] * len(daemons)
    threads = []

    def worker(index, daemon):
        pools[index] = read_pool(daemon)

    for index, daemon in enumerate(daemons):
        thread = threading.Thread(target=worker, args=(index, daemon), daemon=True)
        thread.start()
        threads.append(thread)
    for thread in threads:
        # Must outlast BOTH attempts plus the backoff. If it doesn't, a slow
        # daemon's slot stays None and the pool disappears from the payload
        # entirely -- which reads as "no server configured" and silently sends
        # claudemode to the wrong decision. Worse than an offline card.
        thread.join(timeout=2 * TIMEOUT + 3)

    payload = {"pools": [p for p in pools if p]}
    for pool in payload["pools"]:
        claude = [a for a in pool["accounts"] if a.get("provider") == "claude"]
        clears = [a["clears_floor"] for a in claude]
        if not pool["online"] or not claude:
            pool["spill"] = None
        elif any(c is None for c in clears):
            # Unknown capacity means the Go side stays local; say so rather than
            # implying the pool is fine.
            pool["spill"] = "unknown"
        else:
            pool["spill"] = "active" if not any(clears) else "inactive"
    return payload


PAGE = r"""<!doctype html>
<meta charset="utf-8">
<title>subrouter</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
  :root{
    --bg:#07090f; --card:rgba(255,255,255,.045); --edge:rgba(255,255,255,.10);
    --ink:#e9edf6; --dim:#8b93a7; --good:#39e0a4; --warn:#ffc857; --bad:#ff5c7a;
    --unk:#6b7280; --neon:#7c5cff;
  }
  *{box-sizing:border-box}
  body{margin:0;padding:28px;background:
      radial-gradient(1100px 620px at 12% -12%,#1a1240 0%,transparent 60%),
      radial-gradient(900px 520px at 108% 8%,#04303a 0%,transparent 55%),var(--bg);
    color:var(--ink);font:14px/1.5 ui-sans-serif,-apple-system,"SF Pro Text",Inter,system-ui;
    min-height:100vh}
  h1{font-size:15px;letter-spacing:.16em;text-transform:uppercase;color:var(--dim);
    margin:0 0 20px;font-weight:600}
  .grid{display:grid;gap:20px;grid-template-columns:repeat(auto-fit,minmax(410px,1fr))}
  .pool{background:var(--card);border:1px solid var(--edge);border-radius:22px;
    padding:20px 22px;backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);
    box-shadow:0 16px 50px rgba(0,0,0,.45)}
  .phead{display:flex;align-items:center;gap:10px;margin-bottom:4px}
  .pname{font-size:19px;font-weight:640;letter-spacing:-.01em}
  .dot{width:9px;height:9px;border-radius:50%;flex:none}
  .on{background:var(--good);box-shadow:0 0 12px var(--good)}
  .off{background:var(--bad);box-shadow:0 0 12px var(--bad)}
  .base{color:var(--dim);font-size:12px;margin-bottom:14px;word-break:break-all}
  .tag{font-size:10px;letter-spacing:.1em;text-transform:uppercase;padding:3px 9px;
    border-radius:999px;border:1px solid var(--edge);color:var(--dim)}
  .tag.spill{border-color:rgba(255,92,122,.5);color:var(--bad);
    background:rgba(255,92,122,.10)}
  .tag.hold{border-color:rgba(57,224,164,.4);color:var(--good);
    background:rgba(57,224,164,.08)}
  .prov{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);
    margin:16px 0 8px;display:flex;justify-content:space-between}
  .row{display:grid;grid-template-columns:1fr auto auto;gap:4px 12px;padding:9px 0;
    border-top:1px solid rgba(255,255,255,.05)}
  .row:first-of-type{border-top:0}
  .id{font-weight:520;letter-spacing:-.01em}
  .num{font-variant-numeric:tabular-nums;color:var(--dim);font-size:12px;text-align:right}
  /* Time-to-roll sits beside headroom because neither means anything alone:
     the router ranks on weeklyPace = headroom / secondsToRoll, so 42% with a
     day left and 42% with a week left are very different accounts. */
  .roll{font-variant-numeric:tabular-nums;color:var(--dim);font-size:12px;
    text-align:right;min-width:62px}
  .roll.soon{color:var(--warn)}
  .roll.imminent{color:var(--bad);font-weight:600}
  .bar{grid-column:1/-1;height:5px;border-radius:999px;background:rgba(255,255,255,.07);
    overflow:hidden}
  .fill{height:100%;border-radius:999px;transition:width .45s cubic-bezier(.4,0,.2,1)}
  .meta{grid-column:1/-1;color:var(--dim);font-size:11.5px;
    font-variant-numeric:tabular-nums}
  .err{color:var(--bad);font-size:13px;padding:10px 0}
  .foot{color:var(--dim);font-size:11.5px;margin-top:22px}
  .swatch{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:5px}
</style>
<h1>subrouter pools</h1>
<div class="grid" id="grid"></div>
<div class="foot" id="foot">loading…</div>
<script>
const esc = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
// Colour follows the ROUTER'S verdict; the bar's LENGTH carries headroom.
// Mixing both into colour is what made this lie: on a `h >= 40` gradient the
// greenest bar on the box was `thirteen` at 42%, the one account the scheduler
// was refusing (its 5h burn rate, which headroom alone cannot show).
const color = a => {
  if (!a.known || a.headroom_percent === null) return 'var(--unk)';
  if (a.limit_reached) return 'var(--bad)';
  if (a.clears_floor === false) return 'var(--bad)';
  if (a.clears_floor === null || a.clears_floor === undefined) return 'var(--unk)';
  // Routable, but flag the ones running thin so "green" is not one flat claim.
  return a.headroom_percent >= 25 ? 'var(--good)' : 'var(--warn)';
};
// Unknown must never render as a full or empty bar -- both read as a claim.
const width = a => (!a.known || a.headroom_percent === null) ? 100 : Math.max(2, a.headroom_percent);

// "140h" is not a duration a human reads. Days+hours up to a day out, then
// hours, then minutes in the last hour -- the range where it actually matters.
const fmtRoll = h => {
  if (h === null || h === undefined) return '—';
  if (h < 1) return Math.max(1, Math.round(h * 60)) + 'm';
  if (h < 24) return Math.round(h) + 'h';
  const d = Math.floor(h / 24), r = Math.round(h % 24);
  return r ? `${d}d ${r}h` : `${d}d`;
};
// Inside the 24h endgame window the remaining budget expires whether or not
// anyone spends it, so the roll is the urgent number, not the headroom.
const rollClass = h => (h === null || h === undefined) ? ''
  : h <= 6 ? ' imminent' : h <= 24 ? ' soon' : '';

function account(a) {
  const known = a.known && a.headroom_percent !== null;
  const left = known ? a.headroom_percent + '% left' : 'unknown';
  const bits = [];
  if (a.short_percent !== null && a.short_percent !== undefined) bits.push('5h ' + a.short_percent + '%');
  if (a.weekly_percent !== null && a.weekly_percent !== undefined) bits.push('week ' + a.weekly_percent + '%');
  // "not routable" read as "dead", but the gate is on NEW sessions only: a warm
  // sticky session keeps its account until that account is genuinely exhausted.
  // An account can sit here refusing new work while happily serving yours.
  if (a.clears_floor === true) bits.push('takes new sessions');
  else if (a.clears_floor === false) bits.push('no new sessions (still serves warm ones)');
  if (a.limit_reached) bits.push('LIMIT REACHED');
  if (a.auth_valid === false) bits.push('AUTH INVALID');
  const roll = fmtRoll(a.rolls_in_hours);
  return `<div class="row">
    <div class="id">${esc(a.name)}</div><div class="num">${left}</div>
    <div class="roll${rollClass(a.rolls_in_hours)}" title="time until the weekly window rolls">${esc(roll)}</div>
    <div class="bar"><div class="fill" style="width:${width(a)}%;background:${color(a)};${known?'':'opacity:.25'}"></div></div>
    <div class="meta">${bits.map(esc).join(' · ')}</div></div>`;
}

function pool(p) {
  if (!p.online) {
    return `<div class="pool"><div class="phead"><span class="dot off"></span>
      <span class="pname">${esc(p.name)}</span></div>
      <div class="base">${esc(p.base)}</div><div class="err">${esc(p.error||'offline')}</div></div>`;
  }
  let body = '';
  for (const prov of ['claude','codex','kimi','zai']) {
    const rows = p.accounts.filter(a => a.provider === prov);
    if (!rows.length) continue;
    // The ROUTER'S verdict, same as each row's badge. This used to be a local
    // `headroom_percent >= 40` -- the flat floor the scheduler deleted -- so the
    // header said "0/N routable" while every row below it said "routable", and
    // the daemon happily routed to the pool the header called dead.
    const ok = rows.filter(a => a.clears_floor === true).length;
    const unknown = rows.filter(a => a.clears_floor === null || a.clears_floor === undefined).length;
    const label = unknown ? `${ok}/${rows.length} routable, ${unknown} unknown`
                          : `${ok}/${rows.length} routable`;
    body += `<div class="prov"><span>${prov}</span><span>${label}</span></div>`
          + rows.map(account).join('');
  }
  if (!body) body = `<div class="err">no accounts</div>`;
  const spill = p.spill === 'active'
      ? `<span class="tag spill">spilling to server</span>`
      : p.spill === 'inactive' ? `<span class="tag hold">staying local</span>`
      : p.spill === 'unknown' ? `<span class="tag">spill unknown</span>` : '';
  const dflt = p.is_default ? `<span class="tag">default</span>` : '';
  return `<div class="pool"><div class="phead"><span class="dot on"></span>
    <span class="pname">${esc(p.name)}</span>${dflt}${p.is_local?spill:''}</div>
    <div class="base">${esc(p.base)}</div>${body}</div>`;
}

async function tick() {
  try {
    const r = await fetch('/api', {cache:'no-store'});
    const d = await r.json();
    document.getElementById('grid').innerHTML = d.pools.map(pool).join('');
    document.getElementById('foot').innerHTML =
      `<span class="swatch" style="background:var(--good)"></span>takes new sessions
       <span class="swatch" style="background:var(--warn);margin-left:14px"></span>takes new sessions, running thin
       <span class="swatch" style="background:var(--bad);margin-left:14px"></span>no new sessions — still serves warm ones
       <span class="swatch" style="background:var(--unk);margin-left:14px"></span>unknown — never read as spare
       <span style="margin-left:14px">· bar length = headroom · right column = time to weekly roll</span>
       · updated ${new Date().toLocaleTimeString()}`;
  } catch (e) {
    document.getElementById('foot').textContent = 'srdash unreachable: ' + e;
  }
}
tick(); setInterval(tick, 15000);
</script>
"""


class Handler(BaseHTTPRequestHandler):
    def _send(self, code, body, ctype):
        blob = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(blob)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(blob)

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path == "/api":
            self._send(200, json.dumps(build_payload()), "application/json")
        elif path == "/":
            self._send(200, PAGE, "text/html; charset=utf-8")
        else:
            self._send(404, "not found", "text/plain")

    def log_message(self, *_args):
        pass  # a poll every 15s would bury anything worth seeing


def main(argv):
    parser = argparse.ArgumentParser(prog="srdash", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--port", type=int, default=31416)
    parser.add_argument("--no-open", action="store_true")
    parser.add_argument("--once", action="store_true",
                        help="print the JSON payload and exit")
    args = parser.parse_args(argv)

    if args.once:
        print(json.dumps(build_payload(), indent=2))
        return 0

    # Loopback only. The payload is assembled with admin tokens; binding it to
    # anything routable would republish a pool view without any auth of its own.
    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    url = f"http://127.0.0.1:{args.port}/"
    print(f"srdash on {url}  (ctrl-c to stop)")
    if not args.no_open:
        threading.Timer(0.4, lambda: webbrowser.open(url)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
